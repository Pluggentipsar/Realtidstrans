# Azure Speech Services
AZURE_SPEECH_KEY=your-azure-speech-key
AZURE_SPEECH_REGION=swedencentral

# Claude via Azure API
AZURE_CLAUDE_API_KEY=your-azure-claude-api-key
AZURE_CLAUDE_ENDPOINT=https://your-resource.openai.azure.com

# Dual-model strategy: Sonnet for deep analysis, Haiku for fast/frequent tasks
# If only AZURE_CLAUDE_DEPLOYMENT is set, it's used for everything (backward compatible)
AZURE_CLAUDE_DEPLOYMENT=claude-sonnet
AZURE_CLAUDE_DEPLOYMENT_DEEP=claude-sonnet
AZURE_CLAUDE_DEPLOYMENT_FAST=claude-haiku

# Claude Rate Limiting
CLAUDE_MAX_REQUESTS_PER_MINUTE=30
CLAUDE_MAX_REQUESTS_PER_HOUR=500

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/realtidstrans

# Redis (optional, for scaling WebSocket)
REDIS_URL=redis://localhost:6379

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
SESSION_SECRET=change-this-to-a-random-secret
